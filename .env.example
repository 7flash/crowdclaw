# Default jsx-ai provider/model.
GEMINI_API_KEY=
GAME_MODEL=gemini-3-flash-preview
# Gemini 3 Flash Preview input context limit. Override when changing models.
GAME_CONTEXT_WINDOW=1048576
AGENT_MAX_TOKENS=14000
AGENT_MAX_STEPS=8
AGENT_REQUEST_TIMEOUT_MS=90000

# Other jsx-ai providers are supported when GAME_MODEL is changed:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=

DATABASE_PATH=./data/crowdclaw.sqlite
WORKSPACE_ROOT=./data/workspaces
PORT=3000
EMBEDDED_WORKER=1
WORKER_INTERVAL_MS=2000
WORKER_LEASE_MS=60000
FUNDING_SYNC_MS=15000

SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_TIMEOUT_MS=12000
LAMPORTS_PER_CREDIT=10000000

# Local-only convenience. Production startup rejects this when NODE_ENV=production.
ALLOW_DEV_FUNDING=0
