# Codex runtime owns authentication; no OPENAI_API_KEY is required.
JSX_AI_RUNTIME=codex
# Used when JSX_AI_RUNTIME is not codex. Codex runtime uses the model from Codex config.
GAME_MODEL=gpt-5.4-mini
# Optional API-equivalent token-value overrides.
# MODEL_INPUT_USD_PER_MTOK=0.75
# MODEL_CACHED_INPUT_USD_PER_MTOK=0.075
# MODEL_OUTPUT_USD_PER_MTOK=4.50
GAME_CONTEXT_WINDOW=1048576
AGENT_MAX_TOKENS=14000
AGENT_MAX_STEPS=8
AGENT_REQUEST_TIMEOUT_MS=90000
# Hard ceilings only. A v1 that cannot begin producing output promptly should fail and retry.
AGENT_BUILD_TIMEOUT_MS=180000
AGENT_MAX_DURATION_MS=240000

# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=

DATABASE_PATH=./data/crowdclaw.sqlite
# Shared SQLite is opened by the web process and independent bgrun workers.
# busy_timeout is applied to every long-lived SQLite connection.
CROWDCLAW_DB_BUSY_TIMEOUT_MS=10000
WORKSPACE_ROOT=./data/workspaces
# Codex authentication/config/state are inherited unchanged from the service account.
# CrowdClaw does not override CODEX_HOME or CODEX_SQLITE_HOME.
PORT=3000
BGR_GROUP=crowdclaw
AGENT_POLL_MS=2000
AGENT_LEASE_MS=60000
AGENT_SUPERVISOR_MS=15000
FUNDING_SYNC_MS=5000

# Robinhood Chain (Ethereum-compatible L2). Mainnet chain ID 4663.
# The public RPC is rate-limited; use an Alchemy/QuickNode/etc endpoint in production.
ROBINHOOD_CHAIN_ID=4663
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_RPC_TIMEOUT_MS=12000
ROBINHOOD_BLOCKSCOUT_URL=https://robinhoodchain.blockscout.com
# CrowdClaw stores ETH funding in integer gwei-sized units so SQLite/JS never
# handle unsafe 18-decimal wei as Number values. 100000 gwei = 0.0001 ETH.
GWEI_PER_CREDIT=100000
# Secret used to deterministically derive one EVM funding address per project.
# Keep this stable forever once real project wallets have been created.
ROBINHOOD_PROJECT_WALLET_SEED=replace-with-at-least-32-high-entropy-characters
PROJECT_FLOAT_CREDITS=12

TREASURY_SEED_ENABLED=1
TREASURY_RETRY_MS=15000
# Optional platform seed wallet on Robinhood Chain. If absent, the public site
# still boots; projects simply wait for supporter ETH rather than auto-seeding.
ROBINHOOD_TREASURY_PRIVATE_KEY=

ALLOW_DEV_FUNDING=0

# /admin process controls are automatically available on localhost. Set this
# for any remote deployment; the browser sends it only to CrowdClaw admin APIs.
CROWDCLAW_ADMIN_TOKEN=

# Optional token for the cursor-based /api/events notification feed.
# Telegram bots can send it as Authorization: Bearer <token>.
CROWDCLAW_EVENTS_TOKEN=

# Production keeper. Run `bun run keeper` (or `bun run start:kept`) from your
# init system; it keeps the existing TradJS bgrun record alive.
# Historical production installs use the process name `crowdclaw`.
CROWDCLAW_SERVER_PROCESS_NAME=crowdclaw
CROWDCLAW_SERVER_COMMAND=bun server.ts
# Leave blank to probe the TCP port bgrun actually observes for the server PID,
# then fall back to $PORT. This avoids killing a healthy server on e.g. :3111.
CROWDCLAW_KEEPER_HEALTH_URL=
KEEPER_CHECK_MS=5000
KEEPER_HEALTH_TIMEOUT_MS=2500
# A dead PID restarts immediately. A live PID must fail this many HTTP probes before restart.
KEEPER_HEALTH_FAILURES=3
KEEPER_STARTUP_GRACE_MS=15000
KEEPER_RESTART_BACKOFF_MS=5000

