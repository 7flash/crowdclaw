{
  "name": "crowdclaw",
  "version": "4.48.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch server.ts",
    "start": "bun server.ts",
    "keeper": "bun keeper.ts",
    "start:kept": "bun keeper.ts",
    "agent": "bun project-agent-launch.ts",
    "bgrun": "bunx bgrun --dashboard",
    "check": "tsc --noEmit",
    "test": "bun test",
    "smoke": "bun scripts/smoke.ts",
    "verify": "bun run check && bun test && bun run smoke",
    "refresh:jsx-ai": "bun update jsx-ai @openai/codex-sdk"
  },
  "dependencies": {
    "@openai/codex-sdk": "latest",
    "bgrun": "3.14.0",
    "jsx-ai": "latest",
    "measure-fn": "4.0.5",
    "sqlite-zod-orm": "3.33.0",
    "tailwindcss": "4.1.10",
    "tradjs": "4.3.0",
    "zod": "3.25.67",
    "three": "latest",
    "viem": "latest"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.2"
  },
  "tradjs": {
    "serverOnly": [
      "@openai/codex-sdk",
      "viem",
      "bgrun",
      "jsx-ai",
      "sqlite-zod-orm",
      "measure-fn"
    ]
  }
}
