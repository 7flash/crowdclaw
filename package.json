{
  "name": "crowdclaw-live",
  "version": "4.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch server.ts",
    "start": "NODE_ENV=production bun server.ts",
    "worker": "bun worker.ts",
    "check": "tsc --noEmit",
    "test": "bun test",
    "smoke": "bun scripts/smoke.ts",
    "verify": "bun run check && bun test && bun run smoke"
  },
  "dependencies": {
    "@solard/sdk": "0.2.3",
    "jsx-ai": "latest",
    "measure-fn": "4.0.5",
    "sqlite-zod-orm": "3.33.0",
    "tailwindcss": "4.1.10",
    "tradjs": "4.3.0",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.2"
  },
  "tradjs": {
    "serverOnly": [
      "@solard/sdk",
      "jsx-ai",
      "sqlite-zod-orm",
      "measure-fn"
    ]
  }
}
