    "sqlite-zod-orm": "3.33.0",
    "tailwindcss": "4.1.10",
    "tradjs": "4.3.0",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.2"
  },
  "tradjs": {
    "serverOnly": [
      "@openai/codex-sdk",
      "@solard/sdk",
      "bgrun",
